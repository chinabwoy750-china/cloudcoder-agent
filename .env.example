# Universal Modder — environment template
# Copy to .env for local dev. On Render, set these in the dashboard.
# Never commit real secrets.

# ---- HTTP Basic (API + login UI) ----
CLOUDCODER_USERNAME=admin
CLOUDCODER_PASSWORD=change-me-strong
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- OpenCode server (internal only, 127.0.0.1) ----
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me-internal

# ---- Built-in providers (optional; set at least one path to an LLM) ----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# OPENROUTER_API_KEY=...
# GROQ_API_KEY=...
# CEREBRAS_API_KEY=...

# Default model OpenCode should use when the client does not pick one.
# Format: providerID/modelID  (no spaces)
# DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# ---- Custom OpenAI-compatible endpoint (recommended for gpt-china / DeepSeek / proxies) ----
# CUSTOM_AI_BASE_URL must include /v1, e.g.:
#   https://gpt-china.onrender.com/v1
#   https://api.deepseek.com/v1
#
# CUSTOM_AI_API_KEY must be pure ASCII (no bullets •, smart quotes, emoji).
# China-GPT defaults (set your actual key in your private environment; never commit it)
CUSTOM_AI_BASE_URL=https://gpt-china.onrender.com/v1
CUSTOM_AI_API_KEY=replace-with-your-China-GPT-api-key
CUSTOM_AI_PROVIDER=china-gpt
CUSTOM_AI_MODEL=dahl/MiniMaxAI/MiniMax-M2.7
CUSTOM_AI_MODEL_NAME=MiniMax M2.7
CUSTOM_AI_PROVIDER_NAME=China-GPT
DEFAULT_MODEL=china-gpt/dahl/MiniMaxAI/MiniMax-M2.7
#
# CloudCoder calls GET {CUSTOM_AI_BASE_URL}/models to populate the UI selector.
# If discovery fails, it falls back to CUSTOM_AI_MODEL only.

# Optional: prepend a short plan-then-act instruction to each agent prompt.
# PLAN_THEN_ACT=true

# ---- GitHub ----
# Fine-grained PAT: Contents RW, Pull requests RW
GITHUB_TOKEN=
GITHUB_ALLOW_DEFAULT_BRANCH=false
GIT_COMMIT_NAME=Universal Modder
GIT_COMMIT_EMAIL=agent@cloudcoder.local
GIT_CLONE_DEPTH=1

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# ---- Limits ----
WORKSPACE_ROOT=/tmp/cloudcoder
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACT_BYTES=209715200
MAX_ZIP_ENTRIES=5000
COMMAND_TIMEOUT_MS=180000
TASK_TIMEOUT_MS=900000

# ---- Runtime ----
PORT=10000
NODE_ENV=production
LOG_LEVEL=info

# Optional: use a Render persistent disk (mount at /var/data) so website-managed
# provider/API settings survive deploys and restarts.
# RUNTIME_SETTINGS_PATH=/var/data/universal-modder-settings.json

# Faster default agent workflow; select Thorough mode in the website for planning.
PLAN_THEN_ACT=false
AGENT_POLL_MS=750

# Optional durable site-managed settings storage (Upstash Redis REST API).
# Create a Redis database in Upstash and copy its REST URL and REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_PREFIX=universal-modder

# ---------------------------------------------------------------------------
# Multi-user (Phase 7B / Milestone 1)
# ---------------------------------------------------------------------------
# When DATABASE_URL is set, the first admin is bootstrapped from CLOUDCODER_USERNAME/PASSWORD
# if the app_users table is empty. Public registration stays disabled until an admin enables it.
# ALLOW_PUBLIC_REGISTRATION=false
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage (Milestone 2)
# ---------------------------------------------------------------------------
# OBJECT_STORAGE_PATH=/var/data/objects
# OBJECT_MAX_BYTES=83886080
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=

# ---------------------------------------------------------------------------
# Worker isolation (Milestone 3)
# ---------------------------------------------------------------------------
# DOCKER_ISOLATION=false
# WORKER_DOCKER_IMAGE=node:22-bookworm-slim
# WORKER_MEMORY=512m
# WORKER_CPUS=1
# WORKER_PIDS=256
# WORKER_URL=
# WORKER_SHARED_SECRET=
# WORKER_PORT=10001

# ---------------------------------------------------------------------------
# Agent engine (Milestone 4)
# ---------------------------------------------------------------------------
# PLAN_THEN_ACT=true
# AGENT_MAX_REPAIR_ROUNDS=1
